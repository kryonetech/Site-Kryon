rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return request.auth != null && 
             (request.auth.token.email == 'kryonetech@gmail.com' ||
             (exists(/databases/$(database)/documents/admins/$(request.auth.token.email)) &&
              get(/databases/$(database)/documents/admins/$(request.auth.token.email)).data.ativo == true));
    }

    // Default rule: block everything
    match /{document=**} {
      allow read, write: if false;
    }

    function str(v, max) { return v is string && v.size() <= max; }
    // Lead do site: qualquer visitante cria, mas só com os campos do formulário, tamanhos limitados e status inicial.
    function isValidLead(d) {
      return d.keys().hasOnly(['nome', 'empresa', 'telefone', 'email', 'tipoProjeto', 'mensagem', 'status', 'origem', 'ultimoContato', 'createdAt',
                               'resumoConversa', 'segmento', 'objetivoProjeto', 'recursosDesejados', 'leadQualificado'])
        && d.keys().hasAll(['nome', 'telefone', 'status', 'origem', 'createdAt'])
        && str(d.nome, 120) && d.nome.size() >= 2
        && str(d.telefone, 40)
        && (!('empresa' in d) || str(d.empresa, 120))
        && (!('email' in d) || str(d.email, 200))
        && (!('tipoProjeto' in d) || d.tipoProjeto == null || str(d.tipoProjeto, 200))
        && (!('mensagem' in d) || str(d.mensagem, 3000))
        && (!('resumoConversa' in d) || d.resumoConversa == null || str(d.resumoConversa, 3000))
        && (!('segmento' in d) || d.segmento == null || str(d.segmento, 120))
        && (!('objetivoProjeto' in d) || d.objetivoProjeto == null || str(d.objetivoProjeto, 500))
        && (!('recursosDesejados' in d) || d.recursosDesejados == null || str(d.recursosDesejados, 500))
        && (!('leadQualificado' in d) || d.leadQualificado is bool)
        && d.status == 'Novo'
        && d.origem == 'Site'
        && (!('ultimoContato' in d) || d.ultimoContato == null)
        && d.createdAt == request.time;
    }

    // Leads collection:
    match /leads/{leadId} {
      allow create: if isValidLead(request.resource.data);
      allow read, update, delete: if isAdmin();
    }

    // Clientes collection:
    match /clientes/{clienteId} {
      allow read, write: if isAdmin();
    }

    // Projects collection:
    match /projects/{projectId} {
      allow read, write: if isAdmin();
    }
    
    // Admins collection:
    match /admins/{adminId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Users collection:
    match /users/{userId} {
      allow read, write: if isAdmin();
    }
  }
}
